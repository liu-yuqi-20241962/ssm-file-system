<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!--
        MVC 基础架构委托配置类（替代 mvc:annotation-driven）：
        1) 提供 HandlerMapping / HandlerAdapter / 异常解析器等基础设施；
        2) 收集容器中的 WebMvcConfigurer（WebMvcConfig），调用其 addInterceptors 注册登录拦截器。
        注意：Spring 6.1 起 <mvc:annotation-driven/> 不再注册 DelegatingWebMvcConfiguration，
        若不加此行，WebMvcConfigurer#addInterceptors 永远不会被调用，拦截器会静默失效。
    -->
    <bean class="org.springframework.web.servlet.config.annotation.DelegatingWebMvcConfiguration"/>

    <!-- 扫描控制器与全局异常处理器 -->
    <context:component-scan base-package="com.example.ssm.controller"/>

    <!-- 显式注册配置类（WebMvcConfig）：任务书要求使用 WebMvcConfigurer#addInterceptors 注册拦截器 -->
    <bean class="com.example.ssm.config.WebMvcConfig"/>

    <!-- 视图解析器：controller 返回 "list" -> /WEB-INF/views/list.jsp -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
        <!-- order 置前，优先于 DelegatingWebMvcConfiguration 的 mvcViewResolver（无前后缀） -->
        <property name="order" value="1"/>
    </bean>

    <!-- 静态资源（CSS/JS/图片）：放行 /static/**，由拦截器排除 -->
    <mvc:resources mapping="/static/**" location="/static/"/>

    <!-- 文件上传解析器（Servlet 3.0 标准，无需 commons-fileupload） -->
    <bean id="multipartResolver"
          class="org.springframework.web.multipart.support.StandardServletMultipartResolver"/>

</beans>
